{
  "name": "ocean",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run kill:dev && npm run clean:dev && next dev --turbopack",
    "dev:safe": "npm run kill:dev && npm run clean:all && next dev --turbopack",
    "build": "npm run clean:build && next build",
    "start": "next start",
    "lint": "next lint",
    "clean:dev": "if exist .next\\static\\development rmdir /s /q .next\\static\\development 2>nul",
    "clean:build": "if exist .next rmdir /s /q .next 2>nul",
    "clean:all": "npm run clean:build && npm run clean:cache",
    "clean:cache": "if exist node_modules\\.cache rmdir /s /q node_modules\\.cache 2>nul",
    "kill:dev": "taskkill /f /im node.exe 2>nul || echo No processes to kill",
    "restart": "npm run dev:safe"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@radix-ui/themes": "^3.2.1",
    "@react-pdf-viewer/core": "^3.12.0",
    "@react-pdf-viewer/default-layout": "^3.12.0",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/supabase-js": "^2.50.0",
    "@vercel/analytics": "^1.5.0",
    "@vercel/sdk": "^1.8.5",
    "axios": "^1.12.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "ethers": "^6.13.2",
    "framer-motion": "^12.18.1",
    "lucide-react": "^0.515.0",
    "next": "^15.5.3",
    "next-themes": "^0.4.6",
    "node-fetch": "^3.3.2",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.3",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5"
  }
}
